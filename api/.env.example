# Copiá este archivo como .env y completá la contraseña de Postgres.
# El .env NO se comparte ni se sube a ningún lado.

PGHOST=localhost
PGPORT=5432
PGDATABASE=bachometro
PGUSER=postgres
PGPASSWORD=

# Puerto donde queda el sitio (frontend + API)
PORT=5173

# Token para cambiar el estado de un reporte (PATCH /api/reportes/:id/estado).
# Inventá cualquier texto largo. Sirve hasta que haya login de verdad.
ADMIN_TOKEN=
